<?xml version="1.0" encoding="UTF-8"?>
<WidgetTextView>
	<Name>ouText</Name>
	<Priority>0</Priority>
	<BackLayer href="BackBlack.(WidgetLayerSimpleTexture).xdb" />
	<FormatFileRef href="Format.txt" />
	<Placement>
		<X>
			<!-- 
			<Sizing> WIDGET_SIZING_INTERNAL - размер виджета определяется динамически в зависимости от его содержимого.
			-->
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing>
		</X>
		<Y>
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing>
			
			<!-- См. AlchemyWidgetManager:Init() -->
			<Pos>160</Pos>
		</Y>
	</Placement>
	<TextStyle>
		<multiline>true</multiline>
		<wrapText>true</wrapText>
		<showClippedSymbol>false</showClippedSymbol>
		<showClippedLine>false</showClippedLine>
		<lineSpacing>0</lineSpacing>
		<ellipsis>true</ellipsis>
	</TextStyle>
	<TransparentInput>false</TransparentInput>
	<Visible>true</Visible>
	<Enabled>true</Enabled>
	<isHtmlEscaping>true</isHtmlEscaping>
</WidgetTextView>
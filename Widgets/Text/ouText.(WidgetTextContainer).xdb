<?xml version="1.0" encoding="UTF-8"?>
<WidgetTextContainer>
	<Name>ouText</Name>
	<Priority>0</Priority>
	<BackLayer href="BackBlack.(WidgetLayerSimpleTexture).xdb" />
	
	<formatFileRef href="ContainerFormat.txt" />
	<defaultTag>text</defaultTag>
	
	<Placement>
		<X>
			<!-- Фиксируем ширину, чтобы текст красиво переносился, если не влезает -->
			<Sizing>WIDGET_SIZING_DEFAULT</Sizing>
            <Size>650</Size>
		</X>
		<Y>
			<!-- Авторесайзинг по Y -->
			<Sizing>WIDGET_SIZING_INTERNAL</Sizing>
			<Pos>160</Pos>
		</Y>
	</Placement>
	
	<!-- Отключаем обрезку, чтобы текст не скрылся при ресайзинге -->
	<clipContent>false</clipContent>
	
	<widgetsArrangement>WIDGETS_ARRANGEMENT_T2B</widgetsArrangement>
	<elementsInterval>2</elementsInterval>
	
	<TransparentInput>false</TransparentInput>
	<PickChildrenOnly>true</PickChildrenOnly>
	<Visible>true</Visible>
	<Enabled>true</Enabled>
</WidgetTextContainer>
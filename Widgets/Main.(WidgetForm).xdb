<?xml version="1.0" encoding="UTF-8"?>
<WidgetForm>
	<Name>mainForm</Name>
	<Priority>10000</Priority>
	<Children>
		<Item href="Text/ouText.(WidgetTextView).xdb" />
	</Children>
	<Placement>
		<!-- 
			WIDGET_ALIGN_BOTH - растягивает на весь размер экрана.
			Drag&Drop реализация перетаскивания по внутренней области.
		-->
		<X>
			<Align>WIDGET_ALIGN_BOTH</Align>
		</X>
		<Y>
			<Align>WIDGET_ALIGN_BOTH</Align>
		</Y>
	</Placement>
	<Visible>false</Visible>
	<Enabled>true</Enabled>
	<TransparentInput>false</TransparentInput>
	<PickChildrenOnly>true</PickChildrenOnly>
</WidgetForm>